<%- include('partials/head') %>
<%- include('partials/nav') %>

    <div class="container main-content">
        <header class="page-header">
            <h1>Create a New Post</h1>
            <p>Share your thoughts, stories, and ideas with the world.</p>
        </header>

        <div class="form-container">
            <form action="/blogs" method="POST">
                 <div class="form-group">
                    <label for="title">Blog Title</label>
                    <input type="text" id="title" name="title" required placeholder="Enter a catchy title...">
                </div>

                <div class="form-group">
                    <label for="author">Author</label>
                    <input type="text" id="author" name="author" required placeholder="Your name or handle...">
                </div>

                <div class="form-group">
                    <label for="snippet">Blog Snippet</label>
                    <input type="text" id="snippet" name="snippet" required placeholder="A brief summary of your post...">
                </div>

                <div class="form-group">
                    <label for="body">Blog Body</label>
                    <textarea id="body" name="body" rows="6" required placeholder="Write your full article content here..."></textarea>
                </div>

                <button type="submit" class="btn-submit">Publish Post</button>
            </form>
        </div>
    </div>
<%- include('partials/footer') %>
