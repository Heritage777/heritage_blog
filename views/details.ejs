<%- include('./partials/head') %>
<%- include('./partials/nav') %>

    <!-- Main Content Container -->
    <div class="container main-content">
        <div class="details-card">
            <h1 class="details-title"><%= blog.title %></h1>
            
            <div class="blog-meta">
                <p class="card-author">By <%= blog.author %></p>
                <p class="blog-date">Published on: <%= blog.createdAt ? blog.createdAt.toDateString() : 'Date unavailable' %></p>
            </div>

            <div class="blog-body">
                <p><%= blog.body %></p>
            </div>

           <div class="details-actions">
            <a href="/blogs/edit/<%= blog._id %>" class="btn-edit">Edit Post</a>
            <a class="btn-delete" data-doc="<%= blog._id %>">Delete Post</a>
        </div>
        </div>
    </div>

    <%- include('./partials/footer') %>


    <script>
        const deleteButton = document.querySelector('.btn-delete')
            deleteButton.addEventListener('click', async (e)=>{
            const endpoint =  `/blogs/${deleteButton.dataset.doc}`

            try {
            const response = await fetch(endpoint, {
                method: 'DELETE'
            })
            const data = await response.json()
            alert(`${data.title} has been deleted successfully.`)
            window.location.href = data.redirect;
            } catch (err) {
            console.log(err);
        }   
        })

    </script>
