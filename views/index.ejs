<%- include('./partials/head')  %>
<%- include('./partials/nav')  %>

<div class="container main-content">
        <header class="page-header">
            <h2> Welcome, <%= user.username %>!</h2>
            <h1>Latest Articles</h1>
            <p>Thoughts, stories, and ideas on web development.</p>
        </header>

        <div class="blog-grid">
            <% if (blogs.length > 0) { %>
                <% blogs.forEach(blog => { %>
                    <div class="blog-card">
                        <div class="card-body">
                            <h3 class="card-title"><%= blog.title %></h3>
                            <h6 class="card-author">By <%= blog.author %></h6>
                            <p class="card-text"><%= blog.snippet %></p>
                            <p class="blog-date">Published on: <%= blog.createdAt.toDateString() %></p>
                            <a href="/blogs/<%= blog.id %>" class="btn-read">Read More</a>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="no-blogs">
                    <p>No blog posts available at the moment.</p>
                </div>
            <% } %>
        </div>
</div>

<%- include('./partials/footer')  %>
